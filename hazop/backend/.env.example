# Copy to .env and adjust. All values are optional.

# Resolution used to rasterise PDF drawings for OCR (higher = slower but reads small tags better)
RENDER_DPI=300
MAX_UPLOAD_MB=25
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional AI review mode. Add any one key to enable "AI-assisted" analysis in the UI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the main model is busy, rate-limited or retired
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash

# Public deployment limits (0 = off; docker-compose.yml sets sensible values). Rates are per visitor address.
RATE_JOBS_PER_HOUR=0
RATE_DOCS_PER_HOUR=0
RATE_EXPORTS_PER_HOUR=0
# AI-assisted analyses per day for the whole site (protects the AI key's credits)
AI_JOBS_PER_DAY=0
# New analyses are refused while this many are queued or running
MAX_QUEUED_JOBS=0
# Uploaded drawings and results are deleted after this many hours
JOB_TTL_HOURS=24
# 1 = take the visitor address from X-Forwarded-For (only behind a reverse proxy)
TRUST_PROXY=0
