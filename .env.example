# Local development: copy to .env.local. VPS (docker compose): copy to .env next to docker-compose.yml.

# Free access key from https://web3forms.com (create it with rajeshdgupta2001@gmail.com).
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Domain(s) Caddy serves with automatic HTTPS, e.g. "jbstechservices.com, www.jbstechservices.com".
# Leave empty to serve plain HTTP on the server's IP address. Used by docker compose only.
SITE_ADDRESS=

# Address of the heat exchanger Python backend (simulators/heat-exchanger/backend). The site proxies it at /api/hx.
# Server-side only; defaults to http://localhost:8000. docker compose sets it automatically.
HX_API_URL=

# Only needed when the backend runs on a separate public host with its API_KEY set.
HX_API_KEY=

# HAZOP Studio (served at /hazop, not linked from the site). Enables its AI-assisted mode. docker compose only.
GEMINI_API_KEY=

# HAZOP Studio free sign-up (name, email, company, role) before an analysis. On unless set to 0.
HAZOP_SIGNUP_REQUIRED=1
# 1 = people must also confirm their email with a 6-digit code (needs the Gmail sender below)
HAZOP_SIGNUP_VERIFY_EMAIL=0
# Gmail account that sends the codes: smtp.gmail.com, port 587, the Gmail address and a 16-character App Password
# (Google Account > Security > 2-Step Verification > App passwords).
HAZOP_SMTP_HOST=
HAZOP_SMTP_PORT=587
HAZOP_SMTP_USER=
HAZOP_SMTP_PASSWORD=
HAZOP_SMTP_FROM=
# Download the sign-up list at https://<domain>/hazop/api/admin/signups.xlsx?key=<HAZOP_ADMIN_KEY>
HAZOP_ADMIN_KEY=
